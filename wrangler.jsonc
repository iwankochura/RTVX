{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "rtvx-bio-link",
	"main": "./src/worker.js",
	"compatibility_date": "2026-09-16",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"observability": {
		"enabled": true
	}
}

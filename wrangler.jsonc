{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "yuxia-bio-link",
	"main": "./src/worker.js",
	"compatibility_date": "2026-09-16",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": ["*/2 * * * *"]
	},
	"kv_namespaces": [
		{
			"binding": "STATS_KV",
			"id": "2a191cacd36d4029824561c280a18ffa"
		}
	]
}
